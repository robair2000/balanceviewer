# Copy to .env and fill in. Real environment variables override this file.
# This file is only read locally by server.py - nothing is sent to a browser
# except already-valued JSON.

# ---- KuCoin ----------------------------------------------------------------
# Create a READ-ONLY key: KuCoin -> API Management -> Create API
#   Permissions: General  (NO Trade, NO Transfer/Withdraw)
#   IP whitelist: your current IP is recommended
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
# Funding ("main") accounts are hidden by default. Set to 1 to include them.
KUCOIN_INCLUDE_FUNDING=0
# Sub-accounts: needs a MASTER-account key (a sub-account key cannot see siblings).
# Auto-detects unified account (UTA) mode first, then classic.
KUCOIN_INCLUDE_SUBACCOUNTS=1
# Which sub-account wallet types to count when in UTA mode.
KUCOIN_SUB_ACCOUNT_TYPES=SPOT,FUNDING
KUCOIN_API_BASE=https://api.kucoin.com

# ---- MetaMask / Ethereum mainnet -------------------------------------------
# Your public 0x... address. Never paste the seed phrase or private key.
ETH_ADDRESS=
ETH_LABEL=MetaMask
# Comma separated; first working endpoint is used.
ETH_RPC_URLS=https://eth.drpc.org,https://eth-mainnet.public.blastapi.io,https://1rpc.io/eth,https://rpc.flashbots.net,https://ethereum-rpc.publicnode.com
# Watch extra ERC-20s: SYMBOL:0xCONTRACT:DECIMALS;SYMBOL2:0xCONTRACT:DECIMALS
EXTRA_TOKENS=

# ---- server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
CACHE_SECONDS=45
AUTO_OPEN=1
