# Copy to .streamlit/secrets.toml for local runs:
#   copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#
# On Streamlit Community Cloud do NOT commit that file - paste this block into
# the app's Settings -> Secrets in the dashboard instead.
#
# .streamlit/secrets.toml is git-ignored. Never commit it.

# Required if the app is reachable by anyone but you.
APP_PASSWORD = "choose-a-long-random-string"

# --- KuCoin (read-only key: General permission only, no Trade/Transfer) -----
KUCOIN_API_KEY = ""
KUCOIN_API_SECRET = ""
KUCOIN_PASSPHRASE = ""
# Needs a MASTER-account key to see sub-accounts.
KUCOIN_INCLUDE_SUBACCOUNTS = 1
KUCOIN_SUB_ACCOUNT_TYPES = "SPOT,FUNDING"
KUCOIN_INCLUDE_FUNDING = 0

# --- Ethereum wallet --------------------------------------------------------
ETH_ADDRESS = "0x..."
ETH_LABEL = "MetaMask"
ETH_RPC_URLS = "https://eth.drpc.org,https://eth-mainnet.public.blastapi.io,https://1rpc.io/eth"
# extra ERC-20s: "SYM:0xCONTRACT:DECIMALS;SYM2:0xCONTRACT:DECIMALS"
EXTRA_TOKENS = ""
